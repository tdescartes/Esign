# Copy to .env and adjust. (Loaded by your process manager or `node --env-file=.env server.js` on Node 20+.)
PORT=3000
BASE_URL=http://localhost:3000

# Postgres connection. If unset, the API falls back to an in-memory
# Postgres-compatible engine (pg-mem) for zero-config local dev/tests only —
# never rely on that fallback in production, data does not persist.
DATABASE_URL=postgres://esign:esign@localhost:5432/esign

# Session cookie used for sender authentication.
SESSION_COOKIE_NAME=esign_session

# Local-disk storage for uploaded/sealed PDFs. Swap for S3-compatible storage later.
UPLOAD_DIR=./uploads
SEALED_DIR=./sealed
